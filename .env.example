# Copy this file to .env and fill in what you need. .env is gitignored.
#
# There are two ways to use this repository and they need different things.
# Judging a document needs one key. Running the whole index, with its database
# and its admin portal, needs the rest.


# ---------------------------------------------------------------------------
# 1. Judging a document locally. This is all you need.
# ---------------------------------------------------------------------------
# Every judge is reached through OpenRouter, and that is a requirement rather
# than an economy: the harness prefers a provider's own route whenever that
# provider's key is present, so a stray ANTHROPIC_API_KEY would send one seat
# direct instead of through the mirror the run was priced against.
OPENROUTER_API_KEY=sk-or-v1...

# Then:
#   python3 engine/local_run.py \
#       --document=my-spec@2026-09-12:path/to/spec.md \
#       --behaviour=path/to/behaviour.json \
#       --panel=frontier_fast
# Results land in artefacts/. No database, no account, nothing else set.


# ---------------------------------------------------------------------------
# 2. Running the whole index: the site, the reader, the admin portal.
# ---------------------------------------------------------------------------
# The Supabase project the index shares with evals-playground. Ask the team;
# neither value belongs in the repository.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secr...

# --- signing in to /admin ---
#
# The portal's door is Google sign-in against a list. To sign in locally the way
# you would in production, put YOUR OWN address in ALLOWED_EMAILS below and use
# the same Google client the deployment uses (ask the team for the two values).
# Then `pnpm dev`, open http://localhost:3000/admin, and sign in with Google.
#
# Both lists empty lets nobody in. That is the safe default: a forgotten
# variable locks the door rather than opening it.
ALLOWED_EMAILS=you@example.com
ALLOWED_DOMAINS=

# The session cookie's signing key. `openssl rand -base64 32` makes one, and
# this application should have its own rather than share another's.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Development only, and ignored when NODE_ENV is production: be this operator
# with no Google application at all. Useful when you want the portal open
# without setting up sign-in; comment it out to exercise the real door.
ACI_DEV_OPERATOR=you@example.com

# --- running a job ---
#
# Composing a run, judging it and building a publication are Python, and in
# deployment each is a Cloud Run job started through polaris-batch-trigger.
# On a laptop there is no such service, so naming an interpreter here makes the
# portal start the job as a subprocess instead. The job row records which, so a
# trial on a laptop is never mistaken for production work.
ACI_PYTHON=python3

# The deployed path, for when you want the local portal to start the real job.
# Vercel has no GCP identity, which is why the trigger exists at all.
BATCH_TRIGGER_URL=https://polaris-batch-trigger-g643akjx2a-ew.a.run.app
BATCH_TRIGGER_SECRET=

# --- the public proposal form ---
#
# An incoming webhook for the channel proposals should land in. Without it a
# proposal is still recorded and the log says who was not told.
SLACK_WEBHOOK_URL=
