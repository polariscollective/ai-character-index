# The values come from the Supabase project the index shares with
# evals-playground, and from OpenRouter. Ask the team; none of them
# belong in the repository.
OPENROUTER_API_KEY=sk-or-v1...
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secr...

# --- the admin portal ---
# Sign-in: a Google OAuth client, and a secret for the session cookie.
# `openssl rand -base64 32` makes the secret. Required in production only.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Who may sign in. Both empty lets nobody in, which is the safe default.
ALLOWED_EMAILS=you@example.com
ALLOWED_DOMAINS=

# Development only, and ignored when NODE_ENV is production: be this operator
# without a Google application. Lets the portal run from a bare `pnpm dev`.
ACI_DEV_OPERATOR=you@example.com
# Development only: run the judging job as a subprocess instead of calling the
# Cloud Run trigger. The interpreter to run it with.
ACI_PYTHON=python3

# Deployment: how a long job is started, since Vercel has no GCP identity.
BATCH_TRIGGER_URL=https://polaris-batch-trigger-g643akjx2a-ew.a.run.app
BATCH_TRIGGER_SECRET=
