.DS_Store
node_modules/
dist/
.env
*.log

# Python bytecode and test caches
__pycache__/
*.pyc
.pytest_cache/

# Panel run outputs stay local: each build_site_data.py run emits a timestamped
# payload and updates the manifest; neither is pushed. behaviours.json is the
# tracked fresh-clone fallback; behaviours-v5-reader.json (the keep-set, walker
# oracle + ?data= variant) is a deliberate exception so rebuilds stay addable.
site/spec-reader/data/behaviours-*.json
!site/spec-reader/data/behaviours-v5-reader.json
site/spec-reader/data/manifest.json

# Regenerable experiment artifacts: virtualenvs and model-weight caches
.venv*/
venv/
ckpts/
.claude/settings.local.json
.claude/settings.json
.claude/launch.json
.claude/worktrees/

# User-registered specs for engine/spec-cite/cite.py: the manifest
# (specs/user/specs.json) and any spec documents stored under it are
# user-generated and stay local (see engine/README.md, "User specs")
specs/user/

# Private -- not for the public repo
research/sources/Founding an AI Charter organisation.pdf
outreach/

# Builder smoke-test scratch (engine/test_build_reader_test_data.py,
# engine/test_builders_reproduce_payloads.py)
.builder-repro-scratch/

# A fork's own working files: behaviour registry copies, runlogs, scratch payloads.
# AGENTS.md's clone/fork pathway points here. specs/user/ already covers the spec
# and its manifest; this covers everything else a fork produces that is not the
# project's own data. Runlogs cannot be matched by extension -- engine/panel/
# runlog-v3.jsonl is committed on purpose -- so they need a home instead.
local/

# Golden corpus dumps: pinned by digest in tests/golden/corpus-sha256.json, not by
# committed text. dump_goldens.py --write corpus regenerates them locally for diffing.
tests/golden/cite-corpus-*.txt

# The Next.js application. public/ is a copy of site/ made at build time; site/
# is the source and the only one tracked.
.next/
public/
